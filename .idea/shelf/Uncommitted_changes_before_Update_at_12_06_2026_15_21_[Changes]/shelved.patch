+import os
+import uuid
+from datetime import datetime
+
+from flask import Flask, render_template, request, redirect, url_for, flash, jsonify
+
+from database import init_db, insert_image, get_image, get_all_images, update_annotation, get_stats
+from features import extract_features
+from classifier import classify, get_thresholds
+
+app = Flask(__name__)
+app.secret_key = "wdp-secret-key"
+
+UPLOAD_FOLDER = os.path.join("static", "uploads")
+ALLOWED_EXTENSIONS = {"jpg", "jpeg", "png", "webp"}
+MAX_SIZE_BYTES = 10 * 1024 * 1024  # 10 Mo
+
+app.config["UPLOAD_FOLDER"] = UPLOAD_FOLDER
+os.makedirs(UPLOAD_FOLDER, exist_ok=True)
+
+# Initialise la BDD au démarrage
+init_db()
+
+
+def allowed_file(filename):
+    return "." in filename and filename.rsplit(".", 1)[1].lower() in ALLOWED_EXTENSIONS
+
+
+# ─── Page d'accueil / Upload ───────────────────────────────────────────────────
+
+@app.route("/")
+def index():
+    return render_template("index.html")
+
+
+@app.route("/upload", methods=["POST"])
+def upload():
+    if "image" not in request.files:
+        flash("Aucun fichier reçu.", "error")
+        return redirect(url_for("index"))
+
+    file = request.files["image"]
+
+    if file.filename == "":
+        flash("Aucun fichier sélectionné.", "error")
+        return redirect(url_for("index"))
+
+    if not allowed_file(file.filename):
+        flash("Format non supporté. Utilisez JPG, PNG ou WEBP.", "error")
+        return redirect(url_for("index"))
+
+    # Vérifie la taille
+    file.seek(0, 2)
+    size = file.tell()
+    file.seek(0)
+    if size > MAX_SIZE_BYTES:
+        flash("Fichier trop lourd (max 10 Mo).", "error")
+        return redirect(url_for("index"))
+
+    # Sauvegarde avec nom unique
+    ext = file.filename.rsplit(".", 1)[1].lower()
+    unique_name = f"{uuid.uuid4().hex}.{ext}"
+    filepath = os.path.join(UPLOAD_FOLDER, unique_name)
+    file.save(filepath)
+
+    # Extraction des features
+    try:
+        features = extract_features(filepath)
+    except Exception as e:
+        os.remove(filepath)
+        flash(f"Erreur lors de l'analyse de l'image : {e}", "error")
+        return redirect(url_for("index"))
+
+    # Classification automatique
+    auto_label, confidence, reasons = classify(features)
+
+    # Récupère les métadonnées du formulaire
+    def to_float(val):
+        try:
+            return float(val) if val else None
+        except ValueError:
+            return None
+
+    data = {
+        "filename":      file.filename,
+        "filepath":      filepath,
+        "upload_date":   datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
+        "latitude":      to_float(request.form.get("latitude")),
+        "longitude":     to_float(request.form.get("longitude")),
+        "location_name": request.form.get("location_name") or None,
+        "auto_label":    auto_label,
+        "confidence":    confidence,
+        **features
+    }
+
+    image_id = insert_image(data)
+    return redirect(url_for("result", image_id=image_id, reasons=",".join(reasons)))
+
+
+# ─── Page résultat ─────────────────────────────────────────────────────────────
+
+@app.route("/result/<int:image_id>")
+def result(image_id):
+    image = get_image(image_id)
+    if not image:
+        flash("Image introuvable.", "error")
+        return redirect(url_for("index"))
+
+    reasons_raw = request.args.get("reasons", "")
+    reasons = [r for r in reasons_raw.split(",") if r] if reasons_raw else []
+
+    thresholds = get_thresholds()
+    return render_template("result.html", image=image, reasons=reasons, thresholds=thresholds)
+
+
+# ─── Annotation manuelle ───────────────────────────────────────────────────────
+
+@app.route("/annotate/<int:image_id>/<annotation>", methods=["POST"])
+def annotate(image_id, annotation):
+    if annotation not in ("pleine", "vide"):
+        return jsonify({"error": "Annotation invalide"}), 400
+    update_annotation(image_id, annotation)
+    return jsonify({"success": True, "annotation": annotation})
+
+
+# ─── Galerie ───────────────────────────────────────────────────────────────────
+
+@app.route("/gallery")
+def gallery():
+    images = get_all_images(limit=100)
+    return render_template("gallery.html", images=images)
+
+
+# ─── Dashboard ─────────────────────────────────────────────────────────────────
+
+@app.route("/dashboard")
+def dashboard():
+    stats = get_stats()
+    images = get_all_images(limit=200)
+
+    # Prépare les données pour les graphiques matplotlib
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    import io, base64
+
+    charts = {}
+
+    # Graphique 1 : Répartition des annotations
+    if stats["annotated"] > 0:
+        fig, ax = plt.subplots(figsize=(4, 4))
+        labels = []
+        sizes  = []
+        colors = []
+        if stats["pleines"] > 0:
+            labels.append("Pleine"); sizes.append(stats["pleines"]); colors.append("#d62839")
+        if stats["vides"] > 0:
+            labels.append("Vide");   sizes.append(stats["vides"]);   colors.append("#2d6a4f")
+        ax.pie(sizes, labels=labels, colors=colors, autopct="%1.0f%%",
+               startangle=90, textprops={"fontsize": 12})
+        ax.set_title("Annotations manuelles", fontsize=13, pad=10)
+        fig.patch.set_alpha(0)
+        charts["pie"] = fig_to_base64(fig)
+        plt.close(fig)
+
+    # Graphique 2 : Luminosité des images
+    brightness_vals = [img["brightness"] for img in images if img["brightness"] is not None]
+    if brightness_vals:
+        fig, ax = plt.subplots(figsize=(5, 3))
+        ax.hist(brightness_vals, bins=15, color="#52b788", edgecolor="white")
+        ax.set_xlabel("Luminosité")
+        ax.set_ylabel("Nb d'images")
+        ax.set_title("Distribution de la luminosité")
+        ax.axvline(x=100, color="#d62839", linestyle="--", alpha=0.7, label="Seuil bas (100)")
+        ax.axvline(x=180, color="#f4a261", linestyle="--", alpha=0.7, label="Seuil haut (180)")
+        ax.legend(fontsize=8)
+        fig.patch.set_alpha(0)
+        plt.tight_layout()
+        charts["brightness"] = fig_to_base64(fig)
+        plt.close(fig)
+
+    # Graphique 3 : Labels automatiques
+    auto_labels = [img["auto_label"] for img in images if img["auto_label"]]
+    if auto_labels:
+        pleines = auto_labels.count("pleine")
+        vides   = auto_labels.count("vide")
+        fig, ax = plt.subplots(figsize=(4, 3))
+        ax.bar(["Pleine", "Vide"], [pleines, vides], color=["#d62839", "#2d6a4f"])
+        ax.set_title("Classification automatique")
+        ax.set_ylabel("Nb d'images")
+        for i, v in enumerate([pleines, vides]):
+            ax.text(i, v + 0.1, str(v), ha="center", fontweight="bold")
+        fig.patch.set_alpha(0)
+        plt.tight_layout()
+        charts["auto"] = fig_to_base64(fig)
+        plt.close(fig)
+
+    return render_template("dashboard.html", stats=stats, charts=charts, images=images)
+
+
+def fig_to_base64(fig) -> str:
+    """Convertit une figure matplotlib en base64 pour l'afficher en HTML."""
+    buf = io.BytesIO()
+    fig.savefig(buf, format="png", bbox_inches="tight", transparent=True, dpi=110)
+    buf.seek(0)
+    return base64.b64encode(buf.read()).decode("utf-8")
+
+
+if __name__ == "__main__":
+    app.run(debug=True)
