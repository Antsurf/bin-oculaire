+import sqlite3
+import os
+
+DB_PATH = "wdp.db"
+
+
+def get_connection():
+    """Retourne une connexion SQLite avec Row factory pour accès par nom de colonne."""
+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    return conn
+
+
+def init_db():
+    """Crée la table images si elle n'existe pas encore."""
+    conn = get_connection()
+    conn.execute("""
+        CREATE TABLE IF NOT EXISTS images (
+            id              INTEGER PRIMARY KEY AUTOINCREMENT,
+            filename        TEXT    NOT NULL,
+            filepath        TEXT    NOT NULL,
+            upload_date     TEXT    NOT NULL,
+            annotation      TEXT    DEFAULT NULL,      -- 'pleine' | 'vide' | NULL
+            auto_label      TEXT    DEFAULT NULL,      -- label calculé par les règles
+            confidence      TEXT    DEFAULT NULL,      -- 'certain' | 'incertain'
+
+            -- Localisation
+            latitude        REAL    DEFAULT NULL,
+            longitude       REAL    DEFAULT NULL,
+            location_name   TEXT    DEFAULT NULL,
+
+            -- Features basiques
+            file_size_kb    REAL    DEFAULT NULL,
+            width           INTEGER DEFAULT NULL,
+            height          INTEGER DEFAULT NULL,
+            mean_r          REAL    DEFAULT NULL,
+            mean_g          REAL    DEFAULT NULL,
+            mean_b          REAL    DEFAULT NULL,
+            brightness      REAL    DEFAULT NULL,
+
+            -- Features avancées
+            contrast        REAL    DEFAULT NULL,
+            saturation      REAL    DEFAULT NULL,
+            edge_density    REAL    DEFAULT NULL
+        )
+    """)
+    conn.commit()
+    conn.close()
+
+
+def insert_image(data: dict) -> int:
+    """Insère une nouvelle image et retourne son id."""
+    conn = get_connection()
+    cur = conn.execute("""
+        INSERT INTO images (
+            filename, filepath, upload_date,
+            latitude, longitude, location_name,
+            file_size_kb, width, height,
+            mean_r, mean_g, mean_b, brightness,
+            contrast, saturation, edge_density,
+            auto_label, confidence
+        ) VALUES (
+            :filename, :filepath, :upload_date,
+            :latitude, :longitude, :location_name,
+            :file_size_kb, :width, :height,
+            :mean_r, :mean_g, :mean_b, :brightness,
+            :contrast, :saturation, :edge_density,
+            :auto_label, :confidence
+        )
+    """, data)
+    conn.commit()
+    image_id = cur.lastrowid
+    conn.close()
+    return image_id
+
+
+def get_image(image_id: int):
+    """Retourne une image par son id."""
+    conn = get_connection()
+    row = conn.execute("SELECT * FROM images WHERE id = ?", (image_id,)).fetchone()
+    conn.close()
+    return row
+
+
+def get_all_images(limit: int = 100):
+    """Retourne toutes les images, les plus récentes en premier."""
+    conn = get_connection()
+    rows = conn.execute(
+        "SELECT * FROM images ORDER BY id DESC LIMIT ?", (limit,)
+    ).fetchall()
+    conn.close()
+    return rows
+
+
+def update_annotation(image_id: int, annotation: str):
+    """Met à jour l'annotation manuelle d'une image."""
+    conn = get_connection()
+    conn.execute(
+        "UPDATE images SET annotation = ? WHERE id = ?",
+        (annotation, image_id)
+    )
+    conn.commit()
+    conn.close()
+
+
+def get_stats():
+    """Retourne des statistiques globales pour le dashboard."""
+    conn = get_connection()
+    stats = {}
+
+    stats["total"] = conn.execute("SELECT COUNT(*) FROM images").fetchone()[0]
+    stats["annotated"] = conn.execute(
+        "SELECT COUNT(*) FROM images WHERE annotation IS NOT NULL"
+    ).fetchone()[0]
+    stats["pleines"] = conn.execute(
+        "SELECT COUNT(*) FROM images WHERE annotation = 'pleine'"
+    ).fetchone()[0]
+    stats["vides"] = conn.execute(
+        "SELECT COUNT(*) FROM images WHERE annotation = 'vide'"
+    ).fetchone()[0]
+    stats["auto_pleines"] = conn.execute(
+        "SELECT COUNT(*) FROM images WHERE auto_label = 'pleine'"
+    ).fetchone()[0]
+    stats["auto_vides"] = conn.execute(
+        "SELECT COUNT(*) FROM images WHERE auto_label = 'vide'"
+    ).fetchone()[0]
+
+    # Moyennes des features
+    row = conn.execute("""
+        SELECT
+            AVG(brightness), AVG(contrast), AVG(file_size_kb),
+            AVG(saturation), AVG(edge_density)
+        FROM images
+    """).fetchone()
+    stats["avg_brightness"] = round(row[0], 1) if row[0] else 0
+    stats["avg_contrast"]   = round(row[1], 1) if row[1] else 0
+    stats["avg_size_kb"]    = round(row[2], 1) if row[2] else 0
+    stats["avg_saturation"] = round(row[3], 1) if row[3] else 0
+    stats["avg_edge"]       = round(row[4], 4) if row[4] else 0
+
+    conn.close()
+    return stats
