+"""
+classifier.py — Classification par règles conditionnelles (sans ML).
+
+Principe : chaque règle attribue des "points" à la classe 'pleine'.
+Le total détermine le label final et le niveau de confiance.
+
+Avantages de cette approche par score :
+  - Plus robuste qu'un simple if/else unique
+  - Chaque règle est indépendante et justifiable
+  - Facile à ajuster en modifiant les seuils
+"""
+
+# ─── Seuils de classification ──────────────────────────────────────────────────
+# Ces valeurs sont calibrées empiriquement.
+# Règle : si brightness < SEUIL → image sombre → potentiellement pleine (déchets sombres)
+SEUIL_BRIGHTNESS_BAS    = 100   # en dessous = sombre
+SEUIL_BRIGHTNESS_HAUT   = 180   # au dessus = très clair (poubelle souvent vide)
+
+SEUIL_CONTRASTE_ELEVE   = 55    # contraste fort = image complexe/chargée
+SEUIL_CONTRASTE_FAIBLE  = 30    # contraste faible = image uniforme (poubelle vide)
+
+SEUIL_SATURATION_ELEVE  = 40    # saturation élevée = présence de déchets colorés
+SEUIL_SATURATION_FAIBLE = 15    # saturation très faible = image neutre (vide)
+
+SEUIL_EDGE_ELEVE        = 0.06  # beaucoup de contours = image chargée
+SEUIL_EDGE_FAIBLE       = 0.02  # peu de contours = surface uniforme (vide)
+
+SEUIL_TAILLE_GRANDE     = 500   # Ko : fichier lourd souvent = image plus détaillée/chargée
+
+# Score minimum pour décider
+SCORE_PLEINE_CERTAIN    = 3     # ≥ 3 points → "pleine" certain
+SCORE_PLEINE_INCERTAIN  = 1     # 1-2 points → incertain
+
+
+def classify(features: dict) -> tuple[str, str, list[str]]:
+    """
+    Applique les règles conditionnelles et retourne (label, confiance, explications).
+
+    Retour :
+      - label       : 'pleine' | 'vide'
+      - confidence  : 'certain' | 'incertain'
+      - reasons     : liste des règles déclenchées (pour affichage)
+    """
+    score = 0        # score positif = vote pour 'pleine'
+    reasons = []
+
+    brightness  = features.get("brightness", 128)
+    contrast    = features.get("contrast", 0)
+    saturation  = features.get("saturation", 0)
+    edge_density = features.get("edge_density", 0)
+    file_size_kb = features.get("file_size_kb", 0)
+
+    # ── Règle 1 : Luminosité faible → image sombre → probable pleine ──────────
+    if brightness < SEUIL_BRIGHTNESS_BAS:
+        score += 2
+        reasons.append(f"Image sombre (luminosité {brightness:.0f} < {SEUIL_BRIGHTNESS_BAS})")
+    elif brightness > SEUIL_BRIGHTNESS_HAUT:
+        score -= 1
+        reasons.append(f"Image très claire (luminosité {brightness:.0f} > {SEUIL_BRIGHTNESS_HAUT}) → tendance vide")
+
+    # ── Règle 2 : Contraste élevé → image complexe → probable pleine ─────────
+    if contrast > SEUIL_CONTRASTE_ELEVE:
+        score += 1
+        reasons.append(f"Contraste élevé ({contrast:.1f} > {SEUIL_CONTRASTE_ELEVE})")
+    elif contrast < SEUIL_CONTRASTE_FAIBLE:
+        score -= 1
+        reasons.append(f"Contraste faible ({contrast:.1f} < {SEUIL_CONTRASTE_FAIBLE}) → tendance vide")
+
+    # ── Règle 3 : Saturation élevée → déchets colorés visibles ───────────────
+    if saturation > SEUIL_SATURATION_ELEVE:
+        score += 1
+        reasons.append(f"Saturation élevée ({saturation:.1f} > {SEUIL_SATURATION_ELEVE}) → déchets colorés")
+    elif saturation < SEUIL_SATURATION_FAIBLE:
+        score -= 1
+        reasons.append(f"Saturation faible ({saturation:.1f} < {SEUIL_SATURATION_FAIBLE}) → tendance vide")
+
+    # ── Règle 4 : Densité de contours élevée → image chargée ─────────────────
+    if edge_density > SEUIL_EDGE_ELEVE:
+        score += 1
+        reasons.append(f"Beaucoup de contours ({edge_density:.3f} > {SEUIL_EDGE_ELEVE}) → image complexe")
+    elif edge_density < SEUIL_EDGE_FAIBLE:
+        score -= 1
+        reasons.append(f"Peu de contours ({edge_density:.3f} < {SEUIL_EDGE_FAIBLE}) → surface uniforme")
+
+    # ── Règle 5 : Taille de fichier grande ───────────────────────────────────
+    if file_size_kb > SEUIL_TAILLE_GRANDE:
+        score += 1
+        reasons.append(f"Fichier lourd ({file_size_kb:.0f} Ko > {SEUIL_TAILLE_GRANDE} Ko)")
+
+    # ── Décision finale ───────────────────────────────────────────────────────
+    if score >= SCORE_PLEINE_CERTAIN:
+        label      = "pleine"
+        confidence = "certain"
+    elif score >= SCORE_PLEINE_INCERTAIN:
+        label      = "pleine"
+        confidence = "incertain"
+    elif score <= -2:
+        label      = "vide"
+        confidence = "certain"
+    elif score < 0:
+        label      = "vide"
+        confidence = "incertain"
+    else:
+        label      = "vide"
+        confidence = "incertain"
+
+    if not reasons:
+        reasons.append("Aucune règle déclenchée — valeurs dans les plages neutres")
+
+    return label, confidence, reasons
+
+
+def get_thresholds() -> dict:
+    """Retourne les seuils actuels (utile pour les afficher dans l'interface)."""
+    return {
+        "brightness_bas":   SEUIL_BRIGHTNESS_BAS,
+        "brightness_haut":  SEUIL_BRIGHTNESS_HAUT,
+        "contraste_eleve":  SEUIL_CONTRASTE_ELEVE,
+        "contraste_faible": SEUIL_CONTRASTE_FAIBLE,
+        "saturation_eleve": SEUIL_SATURATION_ELEVE,
+        "saturation_faible":SEUIL_SATURATION_FAIBLE,
+        "edge_eleve":       SEUIL_EDGE_ELEVE,
+        "edge_faible":      SEUIL_EDGE_FAIBLE,
+        "taille_grande_kb": SEUIL_TAILLE_GRANDE,
+    }
